{
  // Public routes from Program.cs route table / controllers that must answer 200 with page content.
  "PublicRoutes": [ "/", "/sellings", "/sellings/sold", "/auctions", "/sitemap", "/personal/sell", "/brand/bmw", "/news", "/contact-us", "/sellings/suvs" ],

  // InfoController.Page aliases linked from the footer (Administrator > Pages content).
  "InfoPageAliases": [ "how-it-works", "about-us", "faq", "privacy-policy", "user-agreement" ],

  // ArticlesController.Index categories linked from the footer (NewsCategory titles).
  "ArticleCategories": [ "news", "overviews", "buying-guides", "selling-guides", "partners" ],

  // PersonalController ([Authorize(Roles = "client")]) GET pages.
  "PersonalRoutes": [ "/personal/buying", "/personal/selling", "/personal/favorites", "/personal/settings", "/personal/notifications", "/personal/payments" ],

  // Footer menu (Views/Shared/_FooterPartial.cshtml) - verified by carabia-ui-tests FooterLinkTests.
