{
  // Base settings. Environment files (appsettings.Dev.json / appsettings.Prod.json) override these.
  // Choose the environment with CARABIA_AUTOMATION_ENV (default "Dev").
  // Any value can be overridden with CARABIA_AUTOMATION__Section__Key environment variables.
  "Execution": {
    "BaseUrl": "https://dev.carabiacars.com",
    "Environment": "Dev",
    "Browser": "Chrome",
    "Headless": false,
    "WindowWidth": 1920,
    "WindowHeight": 1080,
    "DefaultTimeoutSeconds": 20,
    "PageLoadTimeoutSeconds": 60,
    "ManualAuthenticationTimeoutSeconds": 600,
    "ScreenshotOnFailure": true,
    "ShowStepBanner": true,
    "PresentationDelayMs": 400,
    "ArtifactsDirectory": "artifacts",
    "ReportsDirectory": "reports",
    "SessionsDirectory": "sessions",
    "TestDataDirectory": "testdata",

    // Write/destructive switches. Keep false unless you run against DEV on purpose.
    // They are forced to false for production no matter what (SafetyGuard).
    "AllowDestructiveTests": false,
    "AllowPaymentWriteTests": false,
    "AllowSellSubmissionTests": false,
    "AllowOfferWriteTests": false,
    "AllowProfileWriteTests": false,

    "ProductionHosts": [ "carabiacars.com", "www.carabiacars.com" ]
  },
  "Authentication": {
    "ClientLoginPath": "/",
    "AdministratorLoginPath": "/Identity/Authorization",
    "BuyerStartPath": "/personal/buying",
    "SellerStartPath": "/personal/selling",
    "AdministratorStartPath": "/administrator/sellings",
    "PreselectCountryCode": "+91",
    "SessionMaxAgeHours": 480
  }
}
