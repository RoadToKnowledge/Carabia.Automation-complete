<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Carabia.Automation.Framework</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Same Selenium version as the working carabia-ui-tests project.
    Selenium Manager (bundled in Selenium.WebDriver) downloads the matching
    chromedriver / msedgedriver automatically, so no driver binaries are stored here.
    Configuration is read with System.Text.Json (in the .NET 8 runtime), so no extra
    configuration packages are required.
  -->
  <ItemGroup>
    <PackageReference Include="Selenium.WebDriver" Version="4.48.0" />
    <PackageReference Include="Selenium.Support" Version="4.48.0" />
  </ItemGroup>

</Project>
