<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Browser tests are slow; give the whole run time. -->
    <TestSessionTimeout>21600000</TestSessionTimeout>
  </RunConfiguration>
  <NUnit>
    <!-- One browser at a time by default. Scripts can override: NUnit.NumberOfTestWorkers=4 -->
    <NumberOfTestWorkers>1</NumberOfTestWorkers>
    <!-- NUnit 3 XML result per run (relative to the test output folder; scripts pass an absolute path). -->
    <TestOutputXml>TestResults/nunit</TestOutputXml>
    <OutputXmlFolderMode>RelativeToResultDirectory</OutputXmlFolderMode>
    <ShowInternalProperties>false</ShowInternalProperties>
  </NUnit>
</RunSettings>
